# Copy this file to .env and fill in your own Supabase project's values.
# Never commit the real .env file — only the anon key belongs in the client,
# and even that should come from your own project, not be shared across clients.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional — crash reporting and analytics stay fully inert (no-op) if left unset.
# Create your own Sentry/PostHog projects whenever you're ready; nothing here is required
# for the app to run.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# The auth-email-sending service (Nodemailer + Supabase Auth Hook, replaces Supabase's
# rate-limited built-in email sending) is a separate Node package with its own env file —
# see server/email-webhook/.env.example, not this one. Its SMTP_*/SUPABASE_AUTH_HOOK_SECRET
# vars are unrelated to the EXPO_PUBLIC_* vars above and must never be mixed into this file
# (this one ships inlined into the client bundle; that one never does).

# Direct Postgres connection string — used only for CLI/scripting (running `supabase db push`
# non-interactively, one-off `psql` access), NEVER by the app itself. CRITICAL: this must
# never be prefixed EXPO_PUBLIC_ — anything with that prefix gets bundled into the client app
# and shipped to every device; a DB password in there would be readable by anyone who
# decompiles the app. Use the *direct* connection (db.<ref>.supabase.co:5432), not the pooler
# one — PgBouncer's transaction-pooling mode breaks some DDL the migrations need. The real
# value belongs only in your local .env (already gitignored) — never paste a real DB password
# into this .example file, into chat, or anywhere else that isn't your own local .env.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Safepay (getsafepay.com) billing — safepay-create-checkout / safepay-verify-payment /
# safepay-webhook / safepay-refund Edge Functions. These are Edge Function secrets, set via
# `supabase secrets set NAME=value` against your own project — they must NEVER appear in this
# file (or any EXPO_PUBLIC_* var, or app.json/eas.json) since they'd ship inside the client
# bundle. See supabase/functions/README-safepay-setup.md for full setup steps.
#   SAFEPAY_ENVIRONMENT       — "sandbox" or "production"
#   SAFEPAY_MERCHANT_API_KEY  — Safepay Dashboard > Developers > API keys
#   SAFEPAY_SECRET_KEY        — Safepay Dashboard > Developers > API keys (server-side only)
#   SAFEPAY_WEBHOOK_SECRET    — shown once when you register a webhook endpoint at
#                               Dashboard > Developers > Endpoints