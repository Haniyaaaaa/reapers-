# Copy to .env and fill in real values. Provider-agnostic SMTP — works with Gmail SMTP,
# Amazon SES, Mailgun, Postmark, or your own mail server. See README.md for setup steps.
#
# Using Gmail: SMTP_USER is the full Gmail address, and SMTP_PASS must be a 16-character
# App Password, NOT the account's normal login password (Gmail rejects the real password
# for SMTP). Generate one at https://myaccount.google.com/apppasswords — this requires
# 2-Step Verification to be turned on for the account first. Paste it below with no spaces.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reapers.support@gmail.com
SMTP_PASS=your-16-char-gmail-app-password
SMTP_FROM="Reapers <reapers.support@gmail.com>"

# Shown once when you enable the "Send Email" Auth Hook in your Supabase project's dashboard
# (Authentication > Hooks) — looks like "v1,whsec_...". Leave empty until you have a live
# project and have enabled the hook.
SUPABASE_AUTH_HOOK_SECRET=

PORT=3000
